            "url": "{{baseUrl}}/api/v1/auth/session",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"dev.dev-user-ana.USER\"\n}"
            }
          }
        },
        {
          "name": "Crear sesión Firebase JWT",
          "request": {
            "method": "POST",
